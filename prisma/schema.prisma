// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?   // For bcryptjs credentials auth
  image         String?
  isOnboarded   Boolean   @default(false)
  profile       Profile?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Profile {
  id              String      @id @default(cuid())
  userId          String      @unique
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline        String
  bio             String?
  experienceYears Int         @default(0)
  seniorityLevel  String      // ENTRY, MID, SENIOR, LEAD, EXECUTIVE
  skills          String[]
  githubUrl       String?
  linkedinUrl     String?
  targetRole      TargetRole?
  resumeAnalysis  ResumeAnalysis?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model TargetRole {
  id             String      @id @default(cuid())
  profileId      String      @unique
  profile        Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  roleTitle      String
  companyType    String      // FAANG, STARTUP, ENTERPRISE, FINTECH, etc.
  jobDescription String?     @db.Text
  focusTopics    String[]
  difficulty     String      // EASY, MEDIUM, HARD, FAANG_LEVEL
  jdAnalysis     JdAnalysis?
  interviewPlan InterviewPlan?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model InterviewPlan {
  id           String     @id @default(cuid())
  targetRoleId String     @unique
  targetRole   TargetRole @relation(fields: [targetRoleId], references: [id], onDelete: Cascade)
  title        String
  difficulty   String     // EASY, MEDIUM, HARD, FAANG_LEVEL
  summary      String?    @db.Text
  questions    Json       // [{ id, order, category, questionText, focusTopic, difficulty, expectedConcepts, evaluationRubric, hint }]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model JdAnalysis {
  id                   String     @id @default(cuid())
  targetRoleId         String     @unique
  targetRole           TargetRole @relation(fields: [targetRoleId], references: [id], onDelete: Cascade)
  fileName             String?
  fileSize             Int?
  rawText              String?    @db.Text
  roleTitle            String?
  seniorityLevel       String?    // ENTRY, MID, SENIOR, LEAD, EXECUTIVE
  companyType          String?
  requiredSkills       Json       // Categorized required skills: [{ category: string, items: string[] }]
  requiredTechnologies String[]   // Flat list of mandatory & preferred technologies
  responsibilities     String[]   // Key responsibilities
  roleExpectations     Json       // { domainKnowledge: [], softSkills: [], minimumExperienceYears: number }
  keyFocusAreas        String[]   // Recommended interview topics
  skillGap             Json?      // Skill gap analysis: { matchPercentage, matchingSkills, missingCriticalSkills, overqualifiedSkills, recommendedFocusAreas }
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
}


model ResumeAnalysis {
  id             String   @id @default(cuid())
  profileId      String   @unique
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  fileName       String?
  fileSize       Int?
  rawText        String?  @db.Text
  candidateName  String?
  headline       String?
  totalYearsExp  Int      @default(0)
  seniorityLevel String?  // ENTRY, MID, SENIOR, LEAD, EXECUTIVE
  skills         Json     // Categorized skills: [{ category: string, items: string[] }]
  technologies   String[] // Flat list of technologies
  experience     Json     // [{ company, role, startDate, endDate, isCurrent, location, description, technologiesUsed, achievements }]
  projects       Json     // [{ title, description, role, technologiesUsed, highlights, githubUrl, liveUrl }]
  education      Json     // [{ institution, degree, fieldOfStudy, graduationYear }]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

